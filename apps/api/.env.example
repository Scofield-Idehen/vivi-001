# Copy to apps/api/.env for local development. Never commit real values.

# The API connects as app_api (never the owner). On Supabase use the transaction pooler (port 6543):
#   postgres://app_api.<project-ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://app_api:change-me@localhost:5432/v01

# Sign-in tokens are checked against the project's published keys.
SUPABASE_URL=https://<project-ref>.supabase.co
# Only for projects still on the legacy shared JWT secret:
# SUPABASE_JWT_SECRET=
# How long one sign-in lasts before a person signs in again (tokens refresh silently within it). 0 = never.
SESSION_MAX_HOURS=48

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173

# The signing secret configured on the Channex webhook. Webhooks are refused until this is set.
# CHANNEX_WEBHOOK_SECRET=

# Listing photos: the service role key lets the API hand out upload tickets for a public bucket that
# holds listing photos and nothing else. Photo uploads answer "not set up yet" until both are set.
# SUPABASE_SERVICE_ROLE_KEY=
# PHOTO_BUCKET=property-photos

# Encrypts secret custom fields (lock codes, Wi-Fi passwords) before they reach the database. At
# least 32 characters; keep it in the secret manager. Secrets can't be saved until it is set, and
# changing it makes every stored secret unreadable, so never rotate it without re-encrypting first.
# FIELD_SECRET_KEY=

PORT=3001
LOG_LEVEL=info
