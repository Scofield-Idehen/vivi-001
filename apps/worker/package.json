{
  "name": "@v01/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "node ../../scripts/build-node.mjs src/main.ts dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "channex:check": "tsx --env-file-if-exists=.env scripts/channex-check.ts",
    "cross-check": "tsx --env-file-if-exists=.env scripts/cross-check.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@v01/channels": "workspace:*",
    "@v01/db": "workspace:*",
    "@v01/integrations": "workspace:*",
    "@v01/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "tsx": "4.23.15"
  }
}
