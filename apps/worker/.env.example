# Copy to apps/worker/.env for local development. Never commit real values.

# The worker connects as app_worker. On Supabase use the session pooler (port 5432 on the pooler host).
DATABASE_URL=postgres://app_worker:change-me@localhost:5432/v01

# pg-boss connects as app_jobs. Without it, scheduled jobs (feed sweep, nightly full sync) are off.
JOBS_DATABASE_URL=postgres://app_jobs:change-me@localhost:5432/v01

# "fake" records calls in memory; use "channex" with a staging key once the Channex account exists.
CHANNEL_PROVIDER=fake
# CHANNEX_BASE_URL=https://staging.channex.io/api/v1
# CHANNEX_API_KEY=

# Platform alerts. Without it, alerts go to the log.
# SLACK_ALERTS_WEBHOOK_URL=
# Where the staff app lives, so an alert links to the page that fixes it, and a guest's message
# links to their stay page (e.g. http://localhost:5173).
# APP_URL=

# Email to direct guests from the Inbox: a Resend API key, and the one address V-01 sends from, on a
# domain verified in Resend. Without them, emails wait in the Inbox and go as soon as these are set.
# RESEND_API_KEY=
# MAIL_FROM=hello@example.com

LOG_LEVEL=info

# The import from Guesty (pnpm guesty:import). Guesty → Settings → Integrations → Open API.
# Never paste these anywhere but here. FIELD_SECRET_KEY is the API's, so lock codes land sealed.
# GUESTY_CLIENT_ID=
# GUESTY_CLIENT_SECRET=
# FIELD_SECRET_KEY=

# Door codes through TTLock: V-01's developer application from euopen.ttlock.com. The operator
# connects its TTLock app account in Workspace → Door locks; FIELD_SECRET_KEY seals the token.
# TTLOCK_CLIENT_ID=
# TTLOCK_CLIENT_SECRET=
