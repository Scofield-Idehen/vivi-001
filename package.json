{
  "name": "v01",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @v01/api --filter @v01/worker --filter @v01/web dev",
    "demo": "pnpm --filter @v01/web dev:demo",
    "build": "pnpm --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "db:generate": "pnpm --filter @v01/db generate",
    "db:migrate": "pnpm --filter @v01/db migrate",
    "db:roles": "pnpm --filter @v01/db roles",
    "db:seed": "pnpm --filter @v01/db seed",
    "db:seed:demo": "pnpm --filter @v01/db seed --demo"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
