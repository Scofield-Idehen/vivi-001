# Copy to packages/db/.env to run migrations, roles and seeds locally. Never commit real values.

# Owner connection, used only for migrations, roles and seeds. Use the DIRECT connection, not a pooler:
#   postgres://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_OWNER_URL=postgres://postgres:postgres@localhost:5432/v01

# Passwords for the application roles (pnpm db:roles). Generate long random values.
APP_API_DB_PASSWORD=
APP_WORKER_DB_PASSWORD=
APP_JOBS_DB_PASSWORD=

# The first admin, invited to Vivistays by pnpm db:seed. Accepted on first sign-in.
SEED_ADMIN_EMAIL=

# Tests create and drop their own databases through this superuser connection.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
